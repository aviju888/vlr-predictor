# Backend Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS - Add your frontend URL (Vercel) here
ALLOWED_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# VLR.gg API
VLR_BASE_URL=https://vlrggapi.vercel.app
VLR_TIMEOUT=30
VLR_RETRY_ATTEMPTS=3
VLR_RETRY_DELAY=1.0

# Caching
CACHE_TTL=300
MAX_CACHE_SIZE=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
